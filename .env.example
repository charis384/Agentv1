# Copy this file to .env and fill in ONLY what you use. Never commit .env.

# ---- Worker (Drafter): ollama | groq ----
WORKER_PROVIDER=ollama
OLLAMA_MODEL=llama3.1:8b            # run once: ollama pull llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_NUM_CTX=8192                 # Ollama's default context is small and silently truncates RAG prompts
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# ---- Manager (Router + Critic): gemini | deepseek ----
MANAGER_PROVIDER=deepseek
GOOGLE_API_KEY=                     # https://aistudio.google.com/apikey (free tier)
GEMINI_MODEL=gemini-3.1-flash-lite  # stable since May 2026. gemini-2.5-flash shuts down 16 Oct 2026 — don't use it.
                                     # model names change often: check https://ai.google.dev/gemini-api/docs/models
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---- Pipeline tuning ----
RETRIEVAL_K=6                       # chunks passed to the Drafter
MAX_REVISIONS=2                     # Critic-triggered redrafts (total drafts = 1 + this)
HISTORY_MAX_TURNS=8                 # prior turns fed to Router+Drafter+Critic (--session). More turns = more tokens on EVERY call.
HISTORY_ANSWER_CHARS=400            # each past answer is truncated to this many chars when injected into prompts
